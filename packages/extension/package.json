{
  "name": "@hew/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc --noEmit -p tsconfig.json",
    "e2e": "pnpm build:e2e && playwright test"
  },
  "dependencies": {
    "@hew/core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "license": "MIT"
}
